# Kosmo host-side environment template.
#
# The Docker Compose stack does NOT require this file: it injects the
# container-internal values itself (see docker-compose.yml). Copy it to `.env`
# (ignored by git) only when running backend processes directly on the host —
# e.g. `just test-backend`, or `uv run uvicorn app.main:app` from `backend/`.
#
# All application settings use the KOSMO_ prefix; see backend/app/core/config.py.

# PostgreSQL as a SQLAlchemy async URL (host perspective; the app DB is `kosmo`).
KOSMO_DATABASE_URL=postgresql+asyncpg://kosmo:kosmo@localhost:5432/kosmo

# Temporal frontend (gRPC) endpoint and namespace (host perspective).
KOSMO_TEMPORAL_HOST=localhost:7233
KOSMO_TEMPORAL_NAMESPACE=default

# JWT signing secret (WP-05). Required by the API; the compose stack injects a
# development-only fallback — set a real value here for anything non-local.
KOSMO_JWT_SECRET=change-me
KOSMO_TEMPORAL_TASK_QUEUE=kosmo-tasks

# JWT signing secret — placeholder only. Generate a real value for local use
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`) and
# never commit it. Used from WP-05 (identity) onward.
KOSMO_JWT_SECRET=change-me-local-development-placeholder

# Fernet key for encrypted provider configuration files. Generate with
# `uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Keep this key stable; rotating it requires re-encrypting stored provider configs.
KOSMO_CONFIG_ENCRYPTION_KEY=
